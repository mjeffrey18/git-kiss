#!/usr/bin/env bash
set -euo pipefail

GITHUB_REPO="mjeffrey18/git-kiss"

# Read version from sibling file (installed or repo)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(cat "$SCRIPT_DIR/.git-kiss-version" 2>/dev/null || echo "0.0.0")"

# ─── Defaults ────────────────────────────────────────────────────────────────

DEFAULT_MAIN_BRANCH="main"
DEFAULT_DEVELOP_BRANCH="develop"
DEFAULT_STAGING_BRANCH="staging"
DEFAULT_FEATURE_PREFIX="feature/"
DEFAULT_USE_TAGS="true"
DEFAULT_INITIALS=""
# WORKTREE_COPY has no scalar default; it is initialised as an empty array below.

# ─── Config Loading ──────────────────────────────────────────────────────────

reset_config() {
  MAIN_BRANCH="$DEFAULT_MAIN_BRANCH"
  DEVELOP_BRANCH="$DEFAULT_DEVELOP_BRANCH"
  STAGING_BRANCH="$DEFAULT_STAGING_BRANCH"
  FEATURE_PREFIX="$DEFAULT_FEATURE_PREFIX"
  USE_TAGS="$DEFAULT_USE_TAGS"
  INITIALS="$DEFAULT_INITIALS"
  WORKTREE_COPY=()
  MAIN_BRANCH_SOURCE="built-in defaults"
  DEVELOP_BRANCH_SOURCE="built-in defaults"
  STAGING_BRANCH_SOURCE="built-in defaults"
  FEATURE_PREFIX_SOURCE="built-in defaults"
  USE_TAGS_SOURCE="built-in defaults"
  INITIALS_SOURCE="built-in defaults"
  WORKTREE_COPY_SOURCE="built-in defaults"
}

# Initialise config state at startup. load_config re-invokes reset_config before
# each (re)load, so both paths seed identical state from this single definition.
#
# KEEP THIS CALL HERE - at top level, immediately after reset_config is defined
# and before any other code runs. It has been moved a few times and each move
# reintroduces the same bug: under `set -u`, any code path that reads a config
# var (or its _SOURCE) before load_config has run - e.g. an early --help, a
# version check, or a die() during argument parsing - dies on an unbound
# variable unless these defaults are already seeded at load time. Do not defer
# it into load_config or a main()/dispatch function.
reset_config

# Set a single scalar config var from its canonical lowercase key. Callers pass
# lowercase keys (the legacy loader lowercases its UPPER_CASE keys first), so the
# case list is the single canonical registry of supported scalar keys.
set_config_value() {
  local key="$1" value="$2" source="$3"
  case "$key" in
    main_branch)    MAIN_BRANCH="$value"; MAIN_BRANCH_SOURCE="$source" ;;
    develop_branch) DEVELOP_BRANCH="$value"; DEVELOP_BRANCH_SOURCE="$source" ;;
    staging_branch) STAGING_BRANCH="$value"; STAGING_BRANCH_SOURCE="$source" ;;
    feature_prefix) FEATURE_PREFIX="$value"; FEATURE_PREFIX_SOURCE="$source" ;;
    use_tags)       USE_TAGS="$value"; USE_TAGS_SOURCE="$source" ;;
    initials)       INITIALS="$value"; INITIALS_SOURCE="$source" ;;
    *) die "Unsupported configuration key: $key" ;;
  esac
}

ensure_private_gk_dir() {
  local gk_dir="$HOME/.gk"
  if [[ -L "$gk_dir" ]] || ! mkdir -p "$gk_dir" || ! chmod 700 "$gk_dir"; then
    warn "Could not safely prepare $gk_dir; continuing without managed global state." >&2
    return 1
  fi
}

atomic_write_private() {
  local target="$1" target_dir tmp
  target_dir="$(dirname "$target")"
  ensure_private_gk_dir || return 1
  [[ "$target_dir" == "$HOME/.gk" ]] || return 1
  tmp="$(mktemp "$target_dir/.gk-write.XXXXXX")" || return 1
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  if ! cat > "$tmp" || ! mv "$tmp" "$target" || ! chmod 600 "$target"; then
    rm -f "$tmp"
    return 1
  fi
}

prepare_global_state() {
  local gk_dir="$HOME/.gk" global="$HOME/.gk/.gitkiss.jsonc" legacy="$HOME/.git-kiss.jsonc"
  ensure_private_gk_dir || return 1
  if [[ -f "$legacy" ]]; then
    if [[ -f "$global" ]]; then
      warn "Global config migration skipped: $global already exists (legacy file preserved)." >&2
    elif atomic_write_private "$global" < "$legacy" && rm -f "$legacy"; then
      success "Migrated global config → $global" >&2
    else
      warn "Could not migrate legacy global config; continuing with existing settings." >&2
      return 1
    fi
  fi
}

# Resolve the config root once for both configuration loading and onboarding.
# A linked worktree inherits files from the main worktree when it has none itself.
config_root() {
  local repo_root main_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
  [[ -n "$repo_root" ]] || return 1
  repo_root="$(cd "$repo_root" && pwd -P)"
  if [[ -f "$repo_root/.gitkiss.jsonc" || -f "$repo_root/.gitkiss.local.jsonc" || -f "$repo_root/.gitkiss" ]]; then
    printf '%s\n' "$repo_root"
    return 0
  fi
  main_root="$(canonical_main_worktree_path)"
  printf '%s\n' "${main_root:-$repo_root}"
}

load_config() {
  local gk_dir="$HOME/.gk"
  local global_jsonc="$gk_dir/.gitkiss.jsonc"
  local legacy_global_jsonc="$HOME/.git-kiss.jsonc"
  local projects_jsonc="$gk_dir/projects.jsonc"
  local global_legacy="$HOME/.git-kiss"

  local cfg_root main_root repo_root
  cfg_root="$(config_root 2>/dev/null || echo "")"
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
  main_root="$(canonical_main_worktree_path 2>/dev/null || echo "")"

  # Reset so a post-onboarding reload cannot retain values from a prior pass.
  reset_config

  # -- Global layer --
  debug "config layer global: $([[ -f "$global_jsonc" ]] && echo found || echo missing) ($global_jsonc)"
  maybe_migrate_or_source "$global_legacy" "$global_jsonc" "global"
  if [[ -f "$global_jsonc" ]]; then
    apply_jsonc_layer "$global_jsonc" "global"
  elif [[ -f "$legacy_global_jsonc" ]]; then
    # Keep loading the legacy file if its secured migration could not complete.
    apply_jsonc_layer "$legacy_global_jsonc" "global legacy"
  fi

  # -- Global project, repo team + personal layers --
  if [[ -n "$cfg_root" ]]; then
    if [[ -f "$projects_jsonc" ]]; then
      if project_store_has_key "$projects_jsonc" "$main_root"; then
        debug "config layer global project: found entry ($projects_jsonc key: $main_root)"
      else
        debug "config layer global project: entry missing ($projects_jsonc key: $main_root)"
      fi
    else
      debug "config layer global project: missing ($projects_jsonc key: $main_root)"
    fi
    apply_project_layer "$projects_jsonc" "$main_root"
    maybe_migrate_or_source "$cfg_root/.gitkiss" "$cfg_root/.gitkiss.jsonc" "repo"
    debug "config layer repo: $([[ -f "$cfg_root/.gitkiss.jsonc" ]] && echo found || echo missing) ($cfg_root/.gitkiss.jsonc)"
    apply_jsonc_layer "$cfg_root/.gitkiss.jsonc" "repo"
    # Linked worktrees inherit the main worktree's personal layer only when
    # they do not provide their own final local override.
    if [[ -n "$main_root" && "$repo_root" != "$main_root" ]]; then
      if [[ -f "$repo_root/.gitkiss.local.jsonc" ]]; then
        debug "config layer local: found ($repo_root/.gitkiss.local.jsonc)"
        apply_jsonc_layer "$repo_root/.gitkiss.local.jsonc" "local"
      else
        debug "config layer local: $([[ -f "$main_root/.gitkiss.local.jsonc" ]] && echo found || echo missing) ($main_root/.gitkiss.local.jsonc)"
        apply_jsonc_layer "$main_root/.gitkiss.local.jsonc" "local"
      fi
    else
      debug "config layer local: $([[ -f "$cfg_root/.gitkiss.local.jsonc" ]] && echo found || echo missing) ($cfg_root/.gitkiss.local.jsonc)"
      apply_jsonc_layer "$cfg_root/.gitkiss.local.jsonc" "local"
    fi
  fi

  normalize_worktree_copy
  debug "config effective: main_branch=$MAIN_BRANCH ($MAIN_BRANCH_SOURCE); develop_branch=${DEVELOP_BRANCH:-} ($DEVELOP_BRANCH_SOURCE); staging_branch=${STAGING_BRANCH:-} ($STAGING_BRANCH_SOURCE); feature_prefix=$FEATURE_PREFIX ($FEATURE_PREFIX_SOURCE); use_tags=$USE_TAGS ($USE_TAGS_SOURCE); initials=${INITIALS:-} ($INITIALS_SOURCE); worktree_copy=${WORKTREE_COPY[*]:-} ($WORKTREE_COPY_SOURCE)"
}

canonical_main_worktree_path() {
  local main
  main="$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1)"
  [[ -n "$main" ]] || main="$(git rev-parse --show-toplevel 2>/dev/null)"
  (cd "$main" && pwd -P)
}

project_store_has_key() {
  local store="$1" key="$2"
  [[ -f "$store" ]] || return 1
  require_command jq "$JSONC_HINT"
  local stripped
  stripped="$(strip_jsonc_comments "$store")"
  printf '%s' "$stripped" | jq -e --arg key "$key" 'type == "object" and has($key) and (.[$key] | type == "object")' >/dev/null 2>&1
}

apply_project_layer() {
  local store="$1" key="$2"
  [[ -f "$store" ]] || return 0
  require_command jq "$JSONC_HINT"
  local stripped entry
  stripped="$(strip_jsonc_comments "$store")"
  if ! printf '%s' "$stripped" | jq -e 'type == "object"' >/dev/null 2>&1; then
    die "Invalid project store: $store"
  fi
  if ! printf '%s' "$stripped" | jq -e --arg key "$key" 'has($key)' >/dev/null 2>&1; then
    return 0
  fi
  entry="$(printf '%s' "$stripped" | jq -c --arg key "$key" '.[$key]')"
  if ! printf '%s' "$entry" | jq -e 'type == "object"' >/dev/null 2>&1; then
    die "Invalid project entry for $key in $store"
  fi
  apply_config_object "$entry" "global project" "$store (key: $key)"
}

# Parse the deliberately small legacy assignment format without executing it.
# Compatibility covers the documented keys and simple quoted/unquoted values only.
parse_legacy_config() {
  local legacy="$1" logical_source="${2:-legacy}" line trimmed key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
    if [[ ! "$trimmed" =~ ^(MAIN_BRANCH|DEVELOP_BRANCH|STAGING_BRANCH|FEATURE_PREFIX|USE_TAGS|INITIALS|WORKTREE_COPY)=(.*)$ ]]; then
      die "Unsafe or unsupported legacy configuration in $legacy"
    fi
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    if [[ "$value" =~ ^\"([^\"\\]|\\.)*\"$ ]]; then
      value="${value:1:${#value}-2}"
      [[ "$value" != *\\* ]] || die "Unsupported escape sequence in legacy configuration: $legacy"
      if [[ "$key" != "WORKTREE_COPY" && ( "$value" == *' '* || "$value" == *$'\t'* ) ]]; then
        die "Unsafe or unsupported legacy configuration in $legacy"
      fi
    elif [[ "$value" =~ ^\'[^\']*\'$ ]]; then
      value="${value:1:${#value}-2}"
      if [[ "$key" != "WORKTREE_COPY" && ( "$value" == *' '* || "$value" == *$'\t'* ) ]]; then
        die "Unsafe or unsupported legacy configuration in $legacy"
      fi
    elif [[ "$value" == *"'"* || "$value" == *'"'* || "$value" == *';'* || "$value" == *'`'* || "$value" == *'$'* || "$value" == *')'* || "$value" == *'&'* || "$value" == *'|'* || "$value" == *'<'* || "$value" == *'>'* || ( "$key" != "WORKTREE_COPY" && ( "$value" == *' '* || "$value" == *$'\t'* ) ) ]]; then
      die "Unsafe or unsupported legacy configuration in $legacy"
    fi
    if [[ "$key" == "WORKTREE_COPY" ]]; then
      IFS=$' \t' read -r -a WORKTREE_COPY <<< "$value"
      WORKTREE_COPY_SOURCE="$logical_source"
    else
      # Normalise the legacy UPPER_CASE key to the canonical lowercase spelling
      # (bash 3.2 has no ${key,,}, so translate with tr).
      set_config_value "$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')" "$value" "$logical_source"
    fi
  done < "$legacy"
  validate_config_values "$legacy"
}

# If a legacy config exists and no JSONC counterpart does, offer conversion or
# parse it safely for this invocation. It is never sourced.
maybe_migrate_or_source() {
  local legacy="$1" jsonc="$2" scope="$3"
  [[ -f "$legacy" ]] || return 0
  [[ -f "$jsonc" ]] && return 0
  if [[ -t 0 && -t 1 ]]; then
    echo -e "${YELLOW}!${NC} Found legacy $legacy (shell format)." >&2
    printf "  Migrate to JSONC now? [Y/n] " >&2
    local ans=""
    read -r ans || true
    if [[ -z "$ans" || "$ans" == [yY] ]]; then
      if declare -f migrate_scope >/dev/null 2>&1; then
        migrate_scope "$scope" "$legacy"
        return 0
      fi
      echo -e "${YELLOW}!${NC} Migration not available yet; parsing legacy file for now." >&2
    else
      # Declined: do not silently source the legacy shell file (it can execute
      # arbitrary code). Ignore this layer so defaults / other layers apply.
      echo -e "${YELLOW}!${NC} Ignoring legacy $legacy - run 'gk migrate' to upgrade when ready." >&2
      return 0
    fi
  else
    echo -e "${YELLOW}!${NC} Parsing legacy $legacy - run 'gk migrate' to upgrade." >&2
  fi
  parse_legacy_config "$legacy" "$scope legacy"
}

# Normalise a legacy WORKTREE_COPY scalar to an array for downstream code.
normalize_worktree_copy() {
  if [[ "$(declare -p WORKTREE_COPY 2>/dev/null)" != "declare -a"* ]]; then
    local _str="${WORKTREE_COPY:-}"
    IFS=$' \t' read -r -a WORKTREE_COPY <<< "$_str"
  fi
}

ensure_gitignore() {
  local root="$1" entry="$2"
  local gi="$root/.gitignore"
  if [[ ! -f "$gi" ]] || ! grep -qxF "$entry" "$gi"; then
    echo "$entry" >> "$gi"
  fi
}

# Normalise a legacy USE_TAGS value into a JSON boolean literal.
use_tags_bool() {
  if [[ "${USE_TAGS:-false}" == "true" ]]; then echo "true"; else echo "false"; fi
}

# Convert legacy WORKTREE_COPY values into a compact JSON array.
legacy_worktree_copy_json() {
  require_command jq "$JSONC_HINT"
  if [[ ${#WORKTREE_COPY[@]} -eq 0 ]]; then
    echo "[]"
    return
  fi
  printf '%s\n' "${WORKTREE_COPY[@]}" | jq -R . | jq -sc .
}

write_repo_jsonc() {
  local team="$1" localf="$2" team_json local_json copy_json
  copy_json="$(legacy_worktree_copy_json)"
  team_json="$(jq -n --arg main "$MAIN_BRANCH" --arg develop "${DEVELOP_BRANCH:-}" --arg staging "${STAGING_BRANCH:-}" --arg prefix "$FEATURE_PREFIX" --argjson tags "$(use_tags_bool)" '{main_branch:$main, develop_branch:$develop, staging_branch:$staging, feature_prefix:$prefix, use_tags:$tags}')"
  local_json="$(jq -n --arg initials "${INITIALS:-}" --argjson copy "$copy_json" '{initials:$initials, worktree_copy:$copy}')"
  {
    cat <<EOF
// git-kiss team config - commit this
// Docs: https://github.com/${GITHUB_REPO}
EOF
    printf '%s\n' "$team_json"
  } > "$team"
  {
    cat <<EOF
// git-kiss personal config - gitignored
EOF
    printf '%s\n' "$local_json"
  } > "$localf"
}

write_global_jsonc() {
  local out="$1" config_json copy_json
  copy_json="$(legacy_worktree_copy_json)"
  config_json="$(jq -n --arg main "${MAIN_BRANCH:-main}" --arg develop "${DEVELOP_BRANCH:-}" --arg staging "${STAGING_BRANCH:-}" --arg prefix "${FEATURE_PREFIX:-feature/}" --argjson tags "$(use_tags_bool)" --arg initials "${INITIALS:-}" --argjson copy "$copy_json" '{main_branch:$main, develop_branch:$develop, staging_branch:$staging, feature_prefix:$prefix, use_tags:$tags, initials:$initials, worktree_copy:$copy}')"
  atomic_write_private "$out" <<EOF
// git-kiss global config
// Docs: https://github.com/${GITHUB_REPO}
$config_json
EOF
}

write_project_store_entry() {
  local store="$1" key="$2" config="$3"
  require_command jq "$JSONC_HINT"
  ensure_private_gk_dir || die "Could not safely prepare $(dirname "$store")"
  local existing='{}' tmp
  if [[ -f "$store" ]]; then
    existing="$(strip_jsonc_comments "$store")"
    if ! printf '%s' "$existing" | jq -e 'type == "object"' >/dev/null 2>&1; then
      die "Project store is malformed: $store"
    fi
  fi
  tmp="$(mktemp "${TMPDIR:-/tmp}/gk-projects.XXXXXX")" || die "Could not update project store"
  if ! printf '%s' "$existing" | jq --arg key "$key" --argjson config "$config" '.[$key] = $config' > "$tmp" || ! atomic_write_private "$store" < "$tmp"; then
    rm -f "$tmp"
    die "Could not safely update project store"
  fi
  rm -f "$tmp"
}

# Migrate one scope. Parses the legacy file inside a subshell so its variables
# do not leak between scopes; file writes persist. On failure, removes any partial
# output and leaves the legacy file untouched.
migrate_scope() {
  local scope="$1" legacy="$2"
  if [[ "$scope" == "global" ]]; then
    local destination="$HOME/.gk/.gitkiss.jsonc"
    ensure_private_gk_dir || die "Could not safely prepare $(dirname "$destination")"
    [[ ! -f "$destination" ]] || { warn "Migration skipped: $destination already exists (legacy file preserved)." >&2; return 0; }
    if ! ( parse_legacy_config "$legacy" "global legacy"; write_global_jsonc "$destination" ); then
      die "Migration failed; left $legacy untouched."
    fi
    mv "$legacy" "${legacy}.bak"
    echo -e "${GREEN}✓${NC} Migrated global config → $destination (backup: ${legacy}.bak)" >&2
  else
    local root
    root="$(dirname "$legacy")"
    if ! ( parse_legacy_config "$legacy" "repo legacy"; write_repo_jsonc "$root/.gitkiss.jsonc" "$root/.gitkiss.local.jsonc" ); then
      rm -f "$root/.gitkiss.jsonc" "$root/.gitkiss.local.jsonc"
      die "Migration failed; left $legacy untouched."
    fi
    mv "$legacy" "${legacy}.bak"
    ensure_gitignore "$root" ".gitkiss.local.jsonc"
    echo -e "${GREEN}✓${NC} Migrated $legacy → .gitkiss.jsonc + .gitkiss.local.jsonc (backup: ${legacy}.bak)" >&2
    echo -e "  ${BLUE}→${NC} Commit .gitkiss.jsonc; delete ${legacy}.bak when satisfied." >&2
  fi
}

migrate_global_jsonc() {
  local legacy="$HOME/.git-kiss.jsonc" destination="$HOME/.gk/.gitkiss.jsonc"
  [[ -f "$legacy" ]] || return 1
  ensure_private_gk_dir || return 1
  if [[ -f "$destination" ]]; then
    warn "Migration skipped: $destination already exists (legacy file preserved)." >&2
    return 0
  fi
  if ! atomic_write_private "$destination" < "$legacy"; then
    warn "Could not migrate legacy global config; left $legacy untouched." >&2
    return 1
  fi
  rm -f "$legacy"
  success "Migrated global config → $destination" >&2
}

cmd_migrate() {
  local did=false
  local gk_dir="$HOME/.gk"
  local global="$gk_dir/.gitkiss.jsonc"
  if [[ -f "$HOME/.git-kiss.jsonc" ]]; then
    migrate_global_jsonc || die "Could not migrate legacy global config."
    did=true
  fi
  if [[ -f "$HOME/.git-kiss" && ! -f "$global" ]]; then
    migrate_scope global "$HOME/.git-kiss"
    did=true
  fi
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
  if [[ -n "$repo_root" && -f "$repo_root/.gitkiss" && ! -f "$repo_root/.gitkiss.jsonc" ]]; then
    migrate_scope repo "$repo_root/.gitkiss"
    did=true
  fi
  if [[ "$did" == false ]]; then
    info "Nothing to migrate."
  fi
}

# ─── Helpers ─────────────────────────────────────────────────────────────────

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
MAGENTA=$'\033[0;35m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m' # No Color

DIM=$'\033[2m'

info()    { echo -e "${BLUE}→${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
warn()    { echo -e "${YELLOW}!${NC} $*"; }
error()   { echo -e "${RED}✗${NC} $*" >&2; }
die()     { error "$@"; exit 1; }
debug_enabled() {
  if [[ -n "${DEBUG+x}" ]]; then [[ "$DEBUG" == "1" ]]; else [[ "${GK_DEBUG:-}" == "1" ]]; fi
}
debug()   { if debug_enabled; then printf '%s[debug] %s%s\n' "$DIM" "$*" "$NC" >&2; fi; }

current_branch() {
  git branch --show-current
}

base_branch() {
  if [[ -n "$DEVELOP_BRANCH" ]]; then
    echo "$DEVELOP_BRANCH"
  else
    echo "$MAIN_BRANCH"
  fi
}

require_git_repo() {
  git rev-parse --git-dir &>/dev/null || die "Not a git repository."
}

require_clean_tree() {
  if [[ -n "$(git status --porcelain)" ]]; then
    die "Working tree is dirty. Please commit or stash your changes first."
  fi
}

require_feature_branch() {
  local branch
  branch="$(current_branch)"
  if [[ "$branch" != "${FEATURE_PREFIX}"* ]]; then
    die "Not on a feature branch. Current branch: $branch (expected prefix: ${FEATURE_PREFIX})"
  fi
}

require_branch_config() {
  local var_name="$1"
  local label="$2"
  if [[ -z "${!var_name}" ]]; then
    die "$label is not configured. This command requires the $label to be set in your .gitkiss config."
  fi
}

require_command() {
  local cmd="$1"
  local install_hint="${2:-}"
  if ! command -v "$cmd" &>/dev/null; then
    if [[ -n "$install_hint" ]]; then
      die "'$cmd' is not installed. $install_hint"
    else
      die "'$cmd' is not installed."
    fi
  fi
}

# ─── Conflict-safe git operations ─────────────────────────────────────────────
# Wrap rebase-/merge-type git commands so a mid-operation conflict is reported
# clearly rather than leaving the user staring at a raw git error. On failure we
# print which operation failed, the branch they are now on, and the exact
# recovery commands, then exit non-zero. The `if !` guard is deliberate: it stops
# `set -e` from aborting the script before we can print the recovery hint.
# Call as: run_rebase "<label>" rebase "$base"   (the leading 'git' is implied).

run_rebase() {
  local label="$1"; shift
  if ! git "$@"; then
    # Captured after the failure: mid-rebase HEAD is detached, so
    # current_branch is empty and the fallback text applies.
    local on
    on="$(current_branch)"
    echo "" >&2
    error "$label failed - you have most likely hit a conflict."
    error "You are now on: ${on:-(detached HEAD - rebase in progress)}"
    echo "" >&2
    echo "  Resolve the conflicts, then continue with:" >&2
    echo "    git rebase --continue" >&2
    echo "  Or abort to undo the rebase entirely:" >&2
    echo "    git rebase --abort" >&2
    exit 1
  fi
}

run_merge() {
  local label="$1"; shift
  if ! git "$@"; then
    local on
    on="$(current_branch)"
    echo "" >&2
    error "$label failed - you have most likely hit a conflict."
    error "You are now on: ${on:-(unknown)}"
    echo "" >&2
    echo "  Resolve the conflicts and commit, or abort with:" >&2
    echo "    git merge --abort" >&2
    exit 1
  fi
}

pull_branch_from_origin() {
  local branch="$1" message="${2:-}"
  [[ -n "$message" ]] && info "$message"
  run_rebase "Pull --rebase of $branch" pull origin "$branch" --rebase
}

checkout_and_pull_branch() {
  local branch="$1"
  local message="${2:-Pulling latest $branch...}"
  info "$message"
  git checkout "$branch"
  pull_branch_from_origin "$branch"
}

rebase_current_onto() {
  local target="$1" current
  current="$(current_branch)"
  info "Rebasing ${current:-current branch} onto $target..."
  run_rebase "Rebase of ${current:-current branch} onto $target" rebase "$target"
}

JSONC_HINT="'jq' is required for git-kiss config. Install it:
    macOS:  brew install jq
    Linux:  apt install jq  (or your package manager)
    Docs:   https://jqlang.github.io/jq/download/"

# Strip full-line // comments (optionally indented). Inline/block comments unsupported.
strip_jsonc_comments() {
  sed 's|^[[:space:]]*//.*$||' "$1"
}

apply_config_object() {
  local object="$1" logical_source="$2" display_source="$3"
  # A present layer is authoritative: malformed types must never make a
  # mutating command fall back to defaults or an earlier layer.
  if ! printf '%s' "$object" | jq -e '
      type == "object"
      and ([keys[] | select(. != "main_branch" and . != "develop_branch" and . != "staging_branch" and . != "feature_prefix" and . != "use_tags" and . != "initials" and . != "worktree_copy")] | length == 0)
      and ((has("main_branch") | not) or (.main_branch | type == "string"))
      and ((has("develop_branch") | not) or (.develop_branch | type == "string"))
      and ((has("staging_branch") | not) or (.staging_branch | type == "string"))
      and ((has("feature_prefix") | not) or (.feature_prefix | type == "string"))
      and ((has("use_tags") | not) or (.use_tags | type == "boolean"))
      and ((has("initials") | not) or (.initials | type == "string"))
      and ((has("worktree_copy") | not) or (.worktree_copy | type == "array" and all(.[]; type == "string")))
    ' >/dev/null 2>&1; then
    die "Invalid configuration: $display_source (expected a supported JSON object with valid value types)"
  fi

  # Read tab-separated key/value pairs, one record per line. jq's @tsv escapes
  # any tab, newline or carriage return inside a value, so such a value stays on
  # a single line and cannot split into a spurious extra key that would trip
  # set_config_value's unknown-key guard.
  local pairs
  if ! pairs="$(printf '%s' "$object" | jq -r 'to_entries[] | select(.key=="main_branch" or .key=="develop_branch" or .key=="staging_branch" or .key=="feature_prefix" or .key=="use_tags" or .key=="initials") | [.key, .value] | @tsv')"; then
    die "Invalid configuration: $display_source (invalid JSON; comments must be on their own line)"
  fi

  local _k _v
  while IFS=$'\t' read -r _k _v; do
    [[ -z "$_k" ]] && continue
    set_config_value "$_k" "$_v" "$logical_source"
  done <<< "$pairs"

  # worktree_copy: only reset when the key is present (present [] overrides; absent leaves prior).
  if printf '%s' "$object" | jq -e 'has("worktree_copy")' >/dev/null 2>&1; then
    WORKTREE_COPY=()
    local _e
    while IFS= read -r _e; do WORKTREE_COPY+=("$_e"); done < <(printf '%s' "$object" | jq -r '.worktree_copy[]?')
    WORKTREE_COPY_SOURCE="$logical_source"
  fi
  debug "config layer $logical_source: contributed $(printf '%s' "$object" | jq -c '.')"
  validate_config_values "$display_source"
}

apply_jsonc_layer() {
  local f="$1" logical_source="${2:-$1}" display_source="${3:-$1}"
  [[ -f "$f" ]] || return 0
  require_command jq "$JSONC_HINT"
  debug "config layer $logical_source: loading $display_source"

  local stripped
  stripped="$(strip_jsonc_comments "$f")"
  apply_config_object "$stripped" "$logical_source" "$display_source"
}

validate_branch_name() {
  local label="$1" value="$2" source="$3"
  [[ -z "$value" ]] && return 0
  git check-ref-format --branch "$value" >/dev/null 2>&1 || die "Invalid $label in $source: $value"
}

validate_config_values() {
  local source="$1" probe
  validate_branch_name "main_branch" "$MAIN_BRANCH" "$source"
  validate_branch_name "develop_branch" "$DEVELOP_BRANCH" "$source"
  validate_branch_name "staging_branch" "$STAGING_BRANCH" "$source"
  [[ "$USE_TAGS" == "true" || "$USE_TAGS" == "false" ]] || die "Invalid use_tags in $source"
  [[ -n "$FEATURE_PREFIX" ]] || die "Invalid feature_prefix in $source"
  probe="${FEATURE_PREFIX}gk-validation"
  validate_branch_name "feature_prefix" "$probe" "$source"
}

# ─── Version Check ──────────────────────────────────────────────────────────

check_version() {
  # Escape hatch for tests / CI / air-gapped use: never stamp or hit the network.
  if [[ -n "${GK_NO_VERSION_CHECK:-}" ]]; then
    debug "version check: skipped (GK_NO_VERSION_CHECK set)"
    return
  fi

  prepare_global_state
  local gk_dir="${HOME}/.gk"
  local stamp_file="$gk_dir/version_check"
  local legacy_stamp="${HOME}/.gk_version_check"
  mkdir -p "$gk_dir" 2>/dev/null || return 0
  if [[ -f "$legacy_stamp" && ! -f "$stamp_file" ]]; then
    mv "$legacy_stamp" "$stamp_file" 2>/dev/null || true
  fi
  debug "version check: local=$VERSION stamp=$stamp_file"

  # Only check once per day
  if [[ -f "$stamp_file" ]]; then
    local last_check
    last_check="$(cat "$stamp_file" 2>/dev/null || echo "0")"
    local now
    now="$(date +%s)"
    local elapsed=$(( now - last_check ))
    debug "version check: last_check=${last_check} now=${now} elapsed=${elapsed}s (threshold=86400s)"
    if [[ "$elapsed" -lt 86400 ]]; then
      debug "version check: skipped (checked recently)"
      return
    fi
  else
    debug "version check: no stamp file, first run"
  fi

  # Update timestamp
  date +%s > "$stamp_file" 2>/dev/null || true
  debug "version check: stamp file updated"

  # Fetch latest version from GitHub (timeout 3s, best-effort)
  if ! command -v curl &>/dev/null; then
    debug "version check: curl not found, skipping"
    return
  fi

  debug "version check: fetching remote version from GitHub..."
  local remote_version
  remote_version="$(curl -fsSL --max-time 3 \
    "https://raw.githubusercontent.com/${GITHUB_REPO}/main/bin/.git-kiss-version" 2>/dev/null)" || { debug "version check: fetch failed"; return; }
  remote_version="$(echo "$remote_version" | tr -d '[:space:]')"

  if [[ -z "$remote_version" ]]; then
    debug "version check: empty remote version"
    return
  fi

  debug "version check: remote=$remote_version local=$VERSION"

  # Compare versions (only warn if remote is newer)
  if [[ "$remote_version" != "$VERSION" ]]; then
    local IFS='.'
    # shellcheck disable=SC2206  # deliberate split on '.' into version components
    local -a local_parts=($VERSION)
    # shellcheck disable=SC2206  # deliberate split on '.' into version components
    local -a remote_parts=($remote_version)
    local is_newer=false

    for idx in 0 1 2; do
      local l="${local_parts[$idx]:-0}"
      local r="${remote_parts[$idx]:-0}"
      if [[ "$r" -gt "$l" ]]; then
        is_newer=true
        break
      elif [[ "$r" -lt "$l" ]]; then
        break
      fi
    done

    if [[ "$is_newer" == true ]]; then
      debug "version check: update available ($VERSION → $remote_version)"
      echo "" >&2
      warn "Update available: ${BOLD}v${VERSION}${NC} → ${BOLD}v${remote_version}${NC}" >&2
      echo -e "   Run: curl -fsSL https://raw.githubusercontent.com/${GITHUB_REPO}/main/install.sh | bash" >&2
      echo "" >&2
    else
      debug "version check: local is up to date (or newer)"
    fi
  else
    debug "version check: versions match, up to date"
  fi
}

# ─── Commands ────────────────────────────────────────────────────────────────

cmd_nf() {
  require_clean_tree

  local name="${1:-}"
  if [[ -z "$name" ]]; then
    die "Usage: gk nf <feature-name>"
  fi

  # Replace spaces with hyphens and lowercase
  name="$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
  if [[ -n "$INITIALS" ]]; then
    name="${INITIALS}-${name}"
  fi
  local branch_name="${FEATURE_PREFIX}${name}"
  validate_branch_name "generated feature branch" "$branch_name" "gk nf"

  local base
  base="$(base_branch)"

  checkout_and_pull_branch "$base" "Checking out $base and pulling latest..."

  info "Creating branch $branch_name..."
  git checkout -b "$branch_name"

  success "Feature branch $branch_name created from $base."
}

cmd_ff() {
  local force=false
  if [[ "${1:-}" == "--force" ]]; then
    force=true
  fi

  require_clean_tree
  require_feature_branch

  local branch
  branch="$(current_branch)"
  local base
  base="$(base_branch)"

  checkout_and_pull_branch "$base"

  git checkout "$branch"

  local behind
  behind="$(git rev-list --count HEAD.."$base")"
  if [[ "$behind" -gt 0 ]]; then
    die "Feature branch is $behind commit(s) behind $base. Run 'gk rf' to rebase first."
  fi

  info "Merging $branch into $base..."
  git checkout "$base"
  run_merge "Merge of $branch into $base" merge "$branch" --no-ff -m "Merge branch '$branch' into $base"

  success "Feature $branch merged into $base."

  if [[ "$force" == true ]]; then
    info "Pushing to origin/$base..."
    git push origin "$base"
    success "Pushed to origin/$base."

    info "Deleting feature branch $branch..."
    git branch -d "$branch"
    git push origin --delete "$branch" 2>/dev/null || true

    success "Branch $branch deleted."
  else
    echo ""
    info "Push your changes:"
    echo "  git push"
  fi
}

cmd_cm() {
  local message="${1:-}"
  if [[ -z "$message" ]]; then
    die "Usage: gk cm <message>"
  fi

  if [[ -z "$(git status --porcelain)" ]]; then
    die "Nothing to commit. Working tree is clean."
  fi

  git add -A
  git commit -m "$message"

  success "Committed: $message"
}

cmd_rc() {
  local force=false
  [[ "${1:-}" == "--force" ]] && force=true
  # Check there is actually a commit to reset
  if ! git rev-parse HEAD~1 >/dev/null 2>&1; then
    die "No commits to reset."
  fi

  if [[ "$force" != true ]]; then
    require_clean_tree
    local branch parents
    branch="$(current_branch)"
    if [[ "$branch" == "$MAIN_BRANCH" || ( -n "$DEVELOP_BRANCH" && "$branch" == "$DEVELOP_BRANCH" ) || ( -n "$STAGING_BRANCH" && "$branch" == "$STAGING_BRANCH" ) ]]; then
      die "Refusing to reset configured base branch $branch. Use 'gk rc!' only for an exceptional recovery."
    fi
    if git branch -r --contains HEAD 2>/dev/null | grep -q '[^[:space:]]'; then
      die "Refusing to reset a commit already published to a remote. Use 'gk rc!' only for an exceptional recovery."
    fi
    parents="$(git rev-list --parents -n 1 HEAD)"
    if [[ "$(wc -w <<< "$parents")" -gt 2 ]]; then
      die "Refusing to reset a merge commit. Use 'gk rc!' only for an exceptional recovery."
    fi
  fi

  local msg
  msg="$(git log -1 --pretty=%s)"

  info "Resetting last commit: $msg"
  git reset --mixed HEAD~1

  # If tree is still clean, the commit was empty.
  if git diff --cached --quiet && git diff --quiet && [[ -z "$(git status --porcelain)" ]]; then
    warn "Commit was empty - no changes to keep."
  else
    success "Last commit reset. Changes unstaged and in working tree."
  fi
}

cmd_pf() {
  require_feature_branch

  local branch
  branch="$(current_branch)"

  info "Publishing $branch..."
  git push --set-upstream origin "$branch"

  success "Branch $branch published to origin."
}

cmd_pr() {
  local subcmd="${1:-}"

  case "$subcmd" in
    ls|list)  cmd_pr_ls ;;
    help|--help|-h) cmd_pr_help ;;
    "")        die "Usage: gk pr <title> [gh flags...]  |  gk pr ls  |  gk pr help" ;;
    *)         cmd_pr_create "$@" ;;
  esac
}

cmd_pr_create() {
  require_command "gh" "Install the GitHub CLI: https://cli.github.com"
  require_feature_branch

  local title="${1:-}"
  if [[ -z "$title" ]]; then
    die "Usage: gk pr <title> [gh flags...]"
  fi
  shift

  local base
  base="$(base_branch)"

  info "Creating pull request targeting $base..."
  gh pr create --base "$base" --title "$title" --fill "$@"
}

cmd_pr_ls() {
  require_command "gh" "Install the GitHub CLI: https://cli.github.com"
  require_command "jq" "Install jq: https://jqlang.github.io/jq/download/"

  # Collect all local branches
  local -a all_branches=()
  local branch

  while IFS= read -r branch; do
    [[ -n "$branch" ]] && all_branches+=("$branch")
  done < <(git branch --format='%(refname:short)' 2>/dev/null)

  if [[ ${#all_branches[@]} -eq 0 ]]; then
    info "No branches found."
    return
  fi

  # Fetch open PRs with lightweight fields. Check details are fetched only for
  # PRs that match a local branch, so large repositories stay responsive.
  local pr_json
  if ! pr_json="$(gh pr list --json number,title,headRefName,isDraft,createdAt,url --state open --limit 1000 2>/dev/null)"; then
    die "Failed to fetch pull requests. Is this a GitHub repository?"
  fi
  if ! printf '%s' "$pr_json" | jq -e 'type == "array"' >/dev/null; then
    die "Failed to parse pull requests returned by GitHub CLI."
  fi

  parse_worktrees
  local current_wt
  current_wt="$(git rev-parse --show-toplevel)"

  # Build a lookup of headRefName -> PR details (one match per branch).
  # Store as parallel arrays for clean iteration
  local -a pr_nums=()
  local -a pr_titles=()
  local -a pr_created_ats=()
  local -a pr_urls=()
  local -a pr_statuses=()
  local -a pr_matched=()

  for branch in "${all_branches[@]}"; do
    local pr_num pr_title pr_created_at pr_url pr_status checks_json
    if pr_num="$(printf '%s' "$pr_json" | jq -er --arg branch "$branch" '
      first(.[] | select(.headRefName == $branch)) | .number
    ')"; then
      pr_title="$(printf '%s' "$pr_json" | jq -er --arg branch "$branch" '
        first(.[] | select(.headRefName == $branch)) | .title
      ')" || die "Failed to parse pull requests returned by GitHub CLI."
      pr_created_at="$(printf '%s' "$pr_json" | jq -er --arg branch "$branch" '
        first(.[] | select(.headRefName == $branch)) | .createdAt
      ')" || die "Failed to parse pull requests returned by GitHub CLI."
      pr_url="$(printf '%s' "$pr_json" | jq -er --arg branch "$branch" '
        first(.[] | select(.headRefName == $branch)) | .url
      ')" || die "Failed to parse pull requests returned by GitHub CLI."
      pr_status="$(printf '%s' "$pr_json" | jq -er --arg branch "$branch" '
        first(.[] | select(.headRefName == $branch)) |
        if .isDraft then "draft"
        else "open"
        end
      ')" || die "Failed to parse pull requests returned by GitHub CLI."
      if [[ "$pr_status" == "open" ]]; then
        checks_json="$(gh pr checks "$pr_num" --required --json bucket 2>/dev/null || true)"
        if [[ -n "$checks_json" ]] && printf '%s' "$checks_json" | jq -e 'type == "array"' >/dev/null 2>&1 &&
           printf '%s' "$checks_json" | jq -e 'any(.[]; .bucket == "fail" or .bucket == "cancel")' >/dev/null; then
          pr_status="failing"
        fi
      fi
      pr_nums+=("$pr_num")
      pr_titles+=("$pr_title")
      pr_created_ats+=("$pr_created_at")
      pr_urls+=("$pr_url")
      pr_statuses+=("$pr_status")
      pr_matched+=("true")
    else
      pr_nums+=("")
      pr_titles+=("")
      pr_created_ats+=("")
      pr_urls+=("")
      pr_statuses+=("none")
      pr_matched+=("false")
    fi
  done

  # Print the table
  echo ""
  printf "  ${BOLD}%-8s %-38s %-34s %-7s %-36s %s${NC}\n" "Status" "Branch" "Worktree" "PR" "Title" "Created"
  echo "  ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"

  local i pr_label
  for i in "${!all_branches[@]}"; do
    local branch="${all_branches[$i]}" display_branch worktree display_title display_created_at wt_i
    display_branch="$branch"
    if [[ ${#display_branch} -gt 38 ]]; then
      display_branch="${display_branch:0:35}..."
    fi
    worktree="—"
    for wt_i in "${!WT_BRANCHES[@]}"; do
      if [[ "${WT_BRANCHES[$wt_i]}" == "$branch" ]]; then
        worktree="${WT_PATHS[$wt_i]#$HOME/}"
        break
      fi
    done
    local status_icon
    case "${pr_statuses[$i]}" in
      draft)   status_icon="${YELLOW}○${NC}" ;;
      open)    status_icon="${GREEN}●${NC}" ;;
      failing) status_icon="${RED}✕${NC}" ;;
      merged)  status_icon="${MAGENTA}✓${NC}" ;;
      closed)  status_icon="${RED}✕${NC}" ;;
      *)       status_icon="${DIM}-${NC}" ;;
    esac

    if [[ "${pr_matched[$i]}" == "true" ]]; then
      display_title="${pr_titles[$i]}"
      if [[ ${#display_title} -gt 36 ]]; then
        display_title="${display_title:0:33}..."
      fi
      display_created_at="${pr_created_ats[$i]:0:10}"
      printf -v pr_label '#%-6s' "${pr_nums[$i]}"
      printf "  %s     %-38s " "$status_icon" "$display_branch"
      print_worktree_path_cell "$worktree" "$current_wt" 34
      printf " "
      printf "${CYAN}\033]8;;%s\033\\%s\033]8;;\033\\${NC} %-36s %s\n" \
        "${pr_urls[$i]}" "$pr_label" "$display_title" "$display_created_at"
    else
      printf "  %s     %-38s " "$status_icon" "$display_branch"
      print_worktree_path_cell "$worktree" "$current_wt" 34
      printf ' %s—%s\n' "$DIM" "$NC"
    fi
  done
  echo ""
  printf '  %s● open  ○ draft  ✕ failing  - none%s\n' "$DIM" "$NC"

  # Check if any PRs were found
  local has_prs=false
  for matched in "${pr_matched[@]}"; do
    if [[ "$matched" == "true" ]]; then
      has_prs=true
      break
    fi
  done

  if [[ "$has_prs" == false ]]; then
    info "No pull requests found for local branches."
  fi
}
cmd_pr_help() {
  cat <<EOF
${BOLD}git-kiss pull requests${NC}

${BOLD}USAGE${NC}
  gk pr <title> [gh flags...]
  gk pr ls
  gk pr help

${BOLD}COMMANDS${NC}
  <title> [flags]  Create a pull request for the current feature branch
  ls               List open pull requests for local branches/worktrees
  help             Show this help message

${BOLD}EXAMPLES${NC}
  gk pr "Add login feature"              Create a PR with auto-filled description
  gk pr "Add login feature" --draft      Create a draft PR
  gk pr ls                               List PRs for all local branches

${BOLD}REQUIREMENTS${NC}
  gh CLI: https://cli.github.com

EOF
}
# Print the greatest strict vMAJOR.MINOR.PATCH tag. Creation dates and
# non-semantic tags are intentionally irrelevant to release numbering.
highest_semver_tag() {
  git tag -l | awk '
    /^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/ {
      split(substr($0, 2), v, ".")
      if (!found || v[1] > a || (v[1] == a && v[2] > b) || (v[1] == a && v[2] == b && v[3] > c)) {
        found=1; a=v[1]; b=v[2]; c=v[3]; tag=$0
      }
    }
    END { if (found) print tag }
  '
}

cmd_dp() {
  local force=false
  if [[ "${1:-}" == "--force" ]]; then
    force=true
  fi

  require_clean_tree
  require_branch_config "DEVELOP_BRANCH" "DEVELOP_BRANCH"

  local current
  current="$(current_branch)"
  if [[ "$current" != "$DEVELOP_BRANCH" ]]; then
    die "You must be on $DEVELOP_BRANCH to deploy to production. Current branch: $current"
  fi

  pull_branch_from_origin "$DEVELOP_BRANCH" "Pulling latest $DEVELOP_BRANCH..."

  checkout_and_pull_branch "$MAIN_BRANCH"

  rebase_current_onto "$DEVELOP_BRANCH"

  if [[ "$USE_TAGS" == "true" ]]; then
    local latest_tag current_release next_release tag

    latest_tag="$(highest_semver_tag)"
    if [[ -n "$latest_tag" ]]; then
      current_release="${latest_tag#v}"
      # Increment patch version
      next_release="$(echo "$current_release" | awk -F. '{$NF = $NF + 1;} 1' | sed 's/ /./g')"
    else
      latest_tag="(none)"
      next_release="0.0.1"
    fi

    tag="v${next_release}"

    info "Previous tag: $latest_tag"
    info "New tag: $tag"

    # Create the tag immediately before the push so a failed or declined push
    # never leaves an orphaned local tag behind - the tag -d cleanup below
    # removes it in every path that does not actually ship.
    git tag -a "$tag" -m "release $tag"

    success "Production deploy prepared. Tag $tag created."

    if [[ "$force" == true ]]; then
      info "Pushing to origin/$MAIN_BRANCH with tags..."
      if git push --atomic origin "refs/heads/$MAIN_BRANCH:refs/heads/$MAIN_BRANCH" "refs/tags/$tag:refs/tags/$tag"; then
        success "Here we go again, shipping to production. Hold onto your hats."
      else
        git tag -d "$tag" >/dev/null
        die "Push to origin/$MAIN_BRANCH failed - removed local tag $tag; nothing was shipped."
      fi
    else
      echo ""
      read -r -p "Push to origin/$MAIN_BRANCH with tags? [y/N] " answer
      if [[ "$answer" == [yY] ]]; then
        if git push --atomic origin "refs/heads/$MAIN_BRANCH:refs/heads/$MAIN_BRANCH" "refs/tags/$tag:refs/tags/$tag"; then
          success "Here we go again, shipping to production. Hold onto your hats."
        else
          git tag -d "$tag" >/dev/null
          die "Push to origin/$MAIN_BRANCH failed - removed local tag $tag; nothing was shipped."
        fi
      else
        git tag -d "$tag" >/dev/null
        echo ""
        info "Push declined - removed local tag $tag. Re-run 'gk dp' when ready to ship."
      fi
    fi
  else
    success "Production deploy prepared."

    if [[ "$force" == true ]]; then
      info "Pushing to origin/$MAIN_BRANCH..."
      git push origin "$MAIN_BRANCH"
      success "Here we go again, shipping to production. Hold onto your hats."
    else
      echo ""
      read -r -p "Push to origin/$MAIN_BRANCH? [y/N] " answer
      if [[ "$answer" == [yY] ]]; then
        git push origin "$MAIN_BRANCH"
        success "Here we go again, shipping to production. Hold onto your hats."
      else
        echo ""
        info "Push your changes:"
        echo "  git push"
      fi
    fi
  fi
}

cmd_ds() {
  local force=false
  if [[ "${1:-}" == "--force" ]]; then
    force=true
  fi

  require_branch_config "STAGING_BRANCH" "STAGING_BRANCH"
  require_feature_branch
  require_clean_tree

  local branch
  branch="$(current_branch)"
  local base
  base="$(base_branch)"

  rebase_current_onto "$base"

  checkout_and_pull_branch "$STAGING_BRANCH"

  rebase_current_onto "$branch"

  success "Staging prepared with changes from $branch."

  if [[ "$force" == true ]]; then
    info "Force pushing to origin/$STAGING_BRANCH..."
    git push --force-with-lease origin "$STAGING_BRANCH"
    success "Shipping to staging! Let's hope we don't take down the DB this time..."
  else
    echo ""
    read -r -p "Force push to origin/$STAGING_BRANCH? [y/N] " answer
    if [[ "$answer" == [yY] ]]; then
      git push --force-with-lease origin "$STAGING_BRANCH"
      success "Shipping to staging! Let's hope we don't take down the DB this time..."
    else
      echo ""
      info "Force push staging:"
      echo "  git push --force-with-lease"
    fi
  fi
}

cmd_fs() {
  local force=false
  if [[ "${1:-}" == "--force" ]]; then
    force=true
  fi

  require_feature_branch
  require_clean_tree

  local branch base merge_base commit_count
  branch="$(current_branch)"
  base="$(base_branch)"

  merge_base="$(git merge-base "$base" HEAD)"
  commit_count="$(git rev-list --count "$merge_base..HEAD")"

  if [[ "$commit_count" -le 1 ]]; then
    success "Only $commit_count commit(s) on this branch - nothing to squash."
    return
  fi

  if [[ "$force" == false ]]; then
    echo ""
    info "Squashing $commit_count commits on $branch:"
    echo ""
    git --no-pager log --oneline "$merge_base..HEAD"
    echo ""
    read -r -p "Proceed? [y/N] " answer
    if [[ "$answer" != [yY] ]]; then
      info "Aborted."
      return
    fi
  fi

  local messages
  messages="$(git log --reverse --format='- %s' "$merge_base..HEAD")"

  git reset --soft "$merge_base"
  git commit -m "$(printf '%s\n\n%s' "$branch" "$messages")"

  success "$commit_count commits squashed into one on $branch."
}

cmd_rf() {
  require_feature_branch
  require_clean_tree

  local branch
  branch="$(current_branch)"
  local base
  base="$(base_branch)"

  checkout_and_pull_branch "$base"

  git checkout "$branch"
  rebase_current_onto "$base"

  success "Branch $branch is up to date with $base."
}

cmd_init() {
  [[ -t 0 && -t 1 ]] || die "gk init requires an interactive terminal."
  local automatic="${1:-}"
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || die "Not a git repository.")"
  local team="$repo_root/.gitkiss.jsonc"
  local localf="$repo_root/.gitkiss.local.jsonc"
  local cfg_root main_root summary_team summary_local
  cfg_root="$(config_root 2>/dev/null || printf '%s' "$repo_root")"
  main_root="$(canonical_main_worktree_path)"
  summary_team="$cfg_root/.gitkiss.jsonc"
  if [[ "$repo_root" != "$main_root" && ! -f "$repo_root/.gitkiss.local.jsonc" ]]; then
    summary_local="$main_root/.gitkiss.local.jsonc"
  else
    summary_local="$repo_root/.gitkiss.local.jsonc"
  fi

  local global="$HOME/.gk/.gitkiss.jsonc" projects="$HOME/.gk/projects.jsonc" key
  key="$(canonical_main_worktree_path)"
  if [[ "$automatic" == "--automatic" ]]; then
    printf "Set up git-kiss for this project? [Y/n] "; read -r answer
    if [[ "$answer" == [nN] ]]; then
      write_project_store_entry "$projects" "$key" '{}'
      info "Inherited settings acknowledged for this project."
      return
    fi
  fi
  local detected_main detected_develop
  detected_main="$(detect_main_branch)"
  detected_develop="$(detect_develop_branch)"
  echo -e "${BOLD}git-kiss setup${NC}"
  init_config_summary "Global" "$global"
  init_project_summary "$projects" "$key"
  init_config_summary "Repo" "$summary_team"
  init_config_summary "Local" "$summary_local"
  printf "Main branch (default: %s): " "$detected_main"; read -r main_branch; main_branch="${main_branch:-$detected_main}"
  printf "Develop branch (blank for simple flow) [%s]: " "$detected_develop"; read -r develop_branch; develop_branch="${develop_branch:-$detected_develop}"
  printf "Staging branch (leave blank to skip): "; read -r staging_branch
  printf "Feature prefix (default: feature/ if blank): "; read -r feature_prefix; feature_prefix="${feature_prefix:-feature/}"
  printf "Use tags? [Y/n]: "; read -r answer; [[ "$answer" == [nN] ]] && use_tags=false || use_tags=true
  printf "Your initials (leave blank to skip): "; read -r initials
  printf "Worktree copy paths, space-separated []: "; read -r worktree_copy
  local config
  config="$(jq -nc --arg main "$main_branch" --arg develop "$develop_branch" --arg staging "$staging_branch" --arg prefix "$feature_prefix" --arg initials "$initials" --arg copy "$worktree_copy" --argjson tags "$use_tags" '{main_branch:$main, develop_branch:$develop, staging_branch:$staging, feature_prefix:$prefix, use_tags:$tags, initials:$initials, worktree_copy:($copy | if . == "" then [] else split(" ") end)}')"
  echo "Choose where to store the config"
  if [[ -f "$global" ]]; then
    echo "1) Global project store"
    echo "2) This repo (Git tracked)"
    echo "3) This repo (local only)"
    printf "Select [1-3]: "; read -r destination
    case "$destination" in
      1) project_store_has_key "$projects" "$key" && { printf "Overwrite project settings? [y/N] "; read -r answer; [[ "$answer" == [yY] ]] || { info "Aborted."; return; }; }; write_project_store_entry "$projects" "$key" "$config"; success "Config written to project store: $projects"; info "Project key: $key" ;;
      2) [[ ! -f "$team" ]] || { printf "Overwrite shared config? [y/N] "; read -r answer; [[ "$answer" == [yY] ]] || { info "Aborted."; return; }; }; printf '// git-kiss shared repo config - commit this\n%s\n' "$config" > "$team"; success "Config written to $team" ;;
      3) [[ ! -f "$localf" ]] || { printf "Overwrite local config? [y/N] "; read -r answer; [[ "$answer" == [yY] ]] || { info "Aborted."; return; }; }; printf '// git-kiss local repo config - gitignored\n%s\n' "$config" > "$localf"; ensure_gitignore "$repo_root" ".gitkiss.local.jsonc"; success "Config written to $localf" ;;
      *) die "Invalid destination." ;;
    esac
  else
    echo "1) Global"
    echo "2) Global project store"
    echo "3) This repo (Git tracked)"
    echo "4) This repo (local only)"
    printf "Select [1-4]: "; read -r destination
    case "$destination" in
      1) printf '// git-kiss global config\n%s\n' "$config" | atomic_write_private "$global" || die "Could not safely write global config"; success "Config written to $global" ;;
      2) project_store_has_key "$projects" "$key" && { printf "Overwrite project settings? [y/N] "; read -r answer; [[ "$answer" == [yY] ]] || { info "Aborted."; return; }; }; write_project_store_entry "$projects" "$key" "$config"; success "Config written to project store: $projects"; info "Project key: $key" ;;
      3) [[ ! -f "$team" ]] || { printf "Overwrite shared config? [y/N] "; read -r answer; [[ "$answer" == [yY] ]] || { info "Aborted."; return; }; }; printf '// git-kiss shared repo config - commit this\n%s\n' "$config" > "$team"; success "Config written to $team" ;;
      4) [[ ! -f "$localf" ]] || { printf "Overwrite local config? [y/N] "; read -r answer; [[ "$answer" == [yY] ]] || { info "Aborted."; return; }; }; printf '// git-kiss local repo config - gitignored\n%s\n' "$config" > "$localf"; ensure_gitignore "$repo_root" ".gitkiss.local.jsonc"; success "Config written to $localf" ;;
      *) die "Invalid destination." ;;
    esac
  fi
}

init_config_summary() {
  local label="$1" file="$2" compact
  if [[ ! -f "$file" ]]; then
    printf '%s: absent (%s)\n' "$label" "$file"
    return
  fi
  compact="$(strip_jsonc_comments "$file" | jq -c . 2>/dev/null || true)"
  if [[ -z "$compact" || "$compact" == "{}" ]]; then
    printf '%s: empty (%s)\n' "$label" "$file"
  else
    printf '%s: %s (%s)\n' "$label" "$compact" "$file"
  fi
}

init_project_summary() {
  local store="$1" key="$2" entry
  if [[ ! -f "$store" ]]; then
    printf 'Global project: absent (%s; key: %s)\n' "$store" "$key"
    return
  fi
  entry="$(strip_jsonc_comments "$store" | jq -c --arg key "$key" '.[$key] // empty' 2>/dev/null || true)"
  if [[ -z "$entry" ]]; then
    printf 'Global project: entry absent (%s; key: %s)\n' "$store" "$key"
  elif [[ "$entry" == "{}" ]]; then
    printf 'Global project: empty (%s; key: %s)\n' "$store" "$key"
  else
    printf 'Global project: %s (%s; key: %s)\n' "$entry" "$store" "$key"
  fi
}

branch_ref_exists() {
  local branch="$1"
  git show-ref --verify --quiet "refs/heads/$branch" || git show-ref --verify --quiet "refs/remotes/origin/$branch"
}

detect_main_branch() {
  if branch_ref_exists main; then echo "main"; elif branch_ref_exists master; then echo "master"; else echo "main"; fi
}

detect_develop_branch() {
  if branch_ref_exists develop; then echo "develop"; elif branch_ref_exists dev; then echo "dev"; else echo "develop"; fi
}

needs_onboarding() {
  local cmd="$1" subcmd="${2:-}" root store key
  [[ -t 0 && -t 1 ]] || return 1
  case "$cmd:$subcmd" in
    nf:*|ff:*|ff!:*|sf:*|sf!:*|pf:*|pr:*|rf:*|ds:*|ds!:*|dp:*|dp!:*|wt:nf|wt:nb) ;;
    *) return 1 ;;
  esac
  root="$(config_root)" || return 1
  [[ ! -f "$root/.gitkiss.jsonc" && ! -f "$root/.gitkiss.local.jsonc" && ! -f "$root/.gitkiss" ]] || return 1
  store="$HOME/.gk/projects.jsonc"; key="$(canonical_main_worktree_path)"
  project_store_has_key "$store" "$key" && return 1
  return 0
}

# ─── Worktree Commands ──────────────────────────────────────────────────────

WT_PATHS=()
WT_BRANCHES=()

parse_worktrees() {
  WT_PATHS=()
  WT_BRANCHES=()
  local path="" branch=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        path="${line#worktree }"
        branch=""
        ;;
      branch\ *)
        branch="${line#branch refs/heads/}"
        ;;
      detached)
        branch="(detached)"
        ;;
      bare)
        path=""
        ;;
      "")
        if [[ -n "$path" ]]; then
          WT_PATHS+=("$path")
          WT_BRANCHES+=("${branch:-???}")
        fi
        path=""
        branch=""
        ;;
    esac
  done < <(git worktree list --porcelain; echo "")
}

repo_name() {
  basename "$(git rev-parse --show-toplevel)"
}

# Return the main worktree path (the original repo root)
main_worktree_path() {
  git worktree list --porcelain | head -1 | sed 's/^worktree //'
}

# Print a compact worktree path, colourising the active worktree. The path is
# shortened from $HOME to ~ so all worktree tables use the same readable form.
print_worktree_path_cell() {
  local path="$1" current_wt="$2" width="$3" display
  if [[ "$path" == "$HOME" ]]; then
    display="~"
  elif [[ "$path" == "$HOME/"* ]]; then
    printf -v display '%s/%s' '~' "${path#"$HOME"/}"
  else
    display="$path"
  fi

  if [[ "$path" == "$current_wt" ]]; then
    display+=" (current)"
  fi
  if [[ ${#display} -gt "$width" ]]; then
    display="${display:0:width-3}..."
  fi

  if [[ "$path" == "$current_wt" ]]; then
    printf "${GREEN}%-${width}s${NC}" "$display"
  else
    printf "%-${width}s" "$display"
  fi
}

# Keep fixed-width terminal columns fixed. printf pads short values, but does
# not truncate long ones, so every value must be shortened before formatting.
truncate_display() {
  local value="$1" width="$2"
  if [[ ${#value} -gt "$width" ]]; then
    printf '%s...' "${value:0:width-3}"
  else
    printf '%s' "$value"
  fi
}

remove_worktree_checked() {
  local main_path="$1" rm_path="$2" remove_status metadata_status=0 worktrees line
  local registration_remains=false filesystem_remains=false

  if git -C "$main_path" worktree remove "$rm_path" --force; then
    remove_status=0
  else
    remove_status=$?
  fi

  if worktrees="$(git -C "$main_path" worktree list --porcelain)"; then
    while IFS= read -r line; do
      if [[ "$line" == "worktree $rm_path" ]]; then
        registration_remains=true
        break
      fi
    done <<< "$worktrees"
  else
    metadata_status=$?
  fi

  if [[ -e "$rm_path" || -L "$rm_path" ]]; then
    filesystem_remains=true
  fi

  if [[ "$metadata_status" -ne 0 ]]; then
    error "Could not verify worktree removal at $rm_path: metadata check failed (exit $metadata_status)."
  elif [[ "$registration_remains" == true && "$filesystem_remains" == true ]]; then
    error "Worktree removal incomplete: registration and filesystem entry remain at $rm_path."
  elif [[ "$registration_remains" == true ]]; then
    error "Worktree removal incomplete: registration remains for $rm_path, but the filesystem entry is absent."
  elif [[ "$filesystem_remains" == true ]]; then
    error "Worktree removal incomplete: registration is absent, but filesystem entry remains at $rm_path."
  elif [[ "$remove_status" -ne 0 ]]; then
    error "Git reported worktree removal failure at $rm_path (exit $remove_status), but registration and filesystem entry are absent."
  else
    return 0
  fi

  if [[ "$remove_status" -ne 0 ]]; then
    return "$remove_status"
  elif [[ "$metadata_status" -ne 0 ]]; then
    return "$metadata_status"
  else
    return 1
  fi
}

# True when $branch is fully merged into $base, evaluated from the main worktree.
# The branch list is captured into a variable before grep sees it: piping
# `git branch --merged` straight into `grep -q` lets grep close the pipe on its
# first match, and under `set -o pipefail` the SIGPIPE-killed git (exit 141)
# would make a genuinely-merged branch read as not merged.
branch_merged_into_base() {
  local main_path="$1" base="$2" branch="$3" merged
  merged="$(git -C "$main_path" branch --merged "$base" --format='%(refname:short)')"
  grep -qxF "$branch" <<< "$merged"
}

# Safely delete a local branch from the main worktree (refuses if unmerged).
# Shared by `gk wt rm` and `gk wt clean` so the two stay consistent and the -C
# main-worktree pinning (cwd-safe when a linked worktree was just removed) lives
# in one place.
delete_merged_branch() {
  local main_path="$1" branch="$2"
  git -C "$main_path" branch -d "$branch"
}

worktree_dir_name() {
  local name="$1"
  local main_path
  main_path="$(main_worktree_path)"
  local repo
  repo="$(basename "$main_path")"
  echo "$(dirname "$main_path")/${repo}--${name}"
}

# Read a .worktreeinclude file (.gitignore-style: one glob per line, blank lines
# and lines beginning with '#' ignored, trailing whitespace and CRLF tolerated)
# and print one cleaned pattern per line.
read_worktreeinclude() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"                     # strip trailing CR (CRLF files)
    line="${line%"${line##*[![:space:]]}"}"  # strip trailing whitespace
    [[ -z "$line" ]] && continue             # skip blank lines
    [[ "$line" == '#'* ]] && continue        # skip comments
    printf '%s\n' "$line"
  done < "$file"
}

validate_worktree_pattern() {
  local pattern="$1" source="$2"
  [[ -n "$pattern" && "$pattern" != /* ]] || die "Unsafe worktree copy pattern in $source: $pattern"
  case "/$pattern/" in *'/../'*|*/'./'*) die "Unsafe worktree copy pattern in $source: $pattern" ;; esac
}

path_is_within() {
  local path="$1" root="$2"
  [[ "$path" == "$root" || "$path" == "$root/"* ]]
}

worktree_copy_includes_path() {
  local path="$1" source
  for source in "${WORKTREE_COPY_SOURCES[@]}"; do
    [[ -n "$source" ]] || continue
    path_is_within "$path" "$source" && return 0
  done
  return 1
}

validate_worktree_symlink() {
  local link="$1" main_path="$2" target target_path target_parent resolved_target
  target="$(readlink "$link")" || die "Could not read worktree copy symlink: $link"
  [[ -n "$target" && "$target" != /* ]] || \
    die "Worktree copy refuses symlinks with absolute targets: $link"
  [[ -e "$link" ]] || die "Worktree copy refuses broken symlinks: $link"

  target_path="$(dirname "$link")/$target"
  if [[ -d "$target_path" ]]; then
    resolved_target="$(cd -P "$target_path" 2>/dev/null && pwd)" || \
      die "Could not resolve worktree copy symlink target: $link"
  else
    target_parent="$(cd -P "$(dirname "$target_path")" 2>/dev/null && pwd)" || \
      die "Could not resolve worktree copy symlink target: $link"
    resolved_target="$target_parent/$(basename "$target_path")"
  fi

  path_is_within "$resolved_target" "$main_path" || \
    die "Worktree copy refuses symlinks whose targets escape the project root: $link -> $target"
  worktree_copy_includes_path "$resolved_target" || \
    die "Worktree copy refuses symlinks whose targets are not copied: $link -> $target"
}

WORKTREE_COPY_MAIN_PATH=""
WORKTREE_COPY_SOURCES=("")

preflight_worktree_copy() {
  local main_path include_file
  main_path="$(canonical_main_worktree_path)"
  WORKTREE_COPY_MAIN_PATH="$main_path"
  WORKTREE_COPY_SOURCES=("")
  include_file="$main_path/.worktreeinclude"
  # A canonical-main .worktreeinclude is authoritative, including when it has
  # no active patterns. Otherwise use the already-resolved configuration array.
  local -a patterns=("")
  local _p
  if [[ -f "$include_file" ]]; then
    debug "worktree copy: .worktreeinclude present; configured worktree_copy suppressed"
    while IFS= read -r _p; do patterns+=("$_p"); done < <(read_worktreeinclude "$include_file")
  else
    debug "worktree copy: .worktreeinclude absent; using configured worktree_copy"
    for _p in "${WORKTREE_COPY[@]:-}"; do [[ -n "$_p" ]] && patterns+=("$_p"); done
  fi

  local saved_nullglob saved_dotglob
  saved_nullglob="$(shopt -p nullglob || true)"
  saved_dotglob="$(shopt -p dotglob || true)"
  shopt -s nullglob dotglob
  # shellcheck disable=SC2064  # expand the saved shopt state now, at trap-set time, on purpose
  trap "eval $(printf '%q' "$saved_nullglob"); eval $(printf '%q' "$saved_dotglob"); trap - RETURN" RETURN

  local pattern src rel_src matched _done=$'\n' src_parent link
  for pattern in "${patterns[@]}"; do
    [[ -z "$pattern" ]] && continue
    validate_worktree_pattern "$pattern" "$([[ -f "$include_file" ]] && echo .worktreeinclude || echo worktree_copy)"
    matched=0
    while IFS= read -r rel_src; do
      src="$main_path/$rel_src"
      [[ -e "$src" || -L "$src" ]] || continue
      src_parent="$(cd -P "$(dirname "$src")" && pwd)" || die "Could not resolve worktree copy source: $src"
      path_is_within "$src_parent" "$main_path" || die "Worktree copy source escapes project root: $src"
      matched=1
      case "$_done" in *$'\n'"$src"$'\n'*) continue ;; esac
      _done="${_done}${src}"$'\n'
      WORKTREE_COPY_SOURCES+=("$src")
    done < <(
      if cd "$main_path"; then
        compgen -G "$pattern" || true
      fi
    )
    if [[ "$matched" -eq 0 ]]; then
      debug "worktree copy: no match for '$pattern'"
    fi
  done

  # cp -a preserves relative symlinks. Permit them only when their targets are
  # inside the project and are part of the same copy set, so the copied link
  # cannot escape the new worktree or depend on a path left in the main one.
  if [[ "${#WORKTREE_COPY_SOURCES[@]}" -gt 1 ]]; then
    while IFS= read -r link; do
      [[ -n "$link" ]] && validate_worktree_symlink "$link" "$main_path"
    done < <(find "${WORKTREE_COPY_SOURCES[@]:1}" -type l -print 2>/dev/null)
  fi
}

copy_worktree_files() {
  local wt_path="$1" src rel dest dest_parent physical_parent copied=0
  for src in "${WORKTREE_COPY_SOURCES[@]}"; do
    [[ -n "$src" ]] || continue
    rel="${src#"$WORKTREE_COPY_MAIN_PATH"/}"
    dest="$wt_path/$rel"
    dest_parent="$(dirname "$dest")"
    mkdir -p "$dest_parent"
    physical_parent="$(cd -P "$dest_parent" && pwd)" || die "Could not resolve worktree copy destination: $dest"
    path_is_within "$physical_parent" "$wt_path" || die "Worktree copy destination escapes worktree: $dest"
    cp -a "$src" "$dest"
    debug "worktree copy: $rel"
    copied=$((copied + 1))
  done

  if [[ "$copied" -gt 0 ]]; then
    info "Copied $copied item(s) into worktree"
  fi
}

cmd_wt() {
  local subcmd="${1:-}"
  if [[ -z "$subcmd" ]]; then
    cmd_wt_help
    return
  fi
  shift

  case "$subcmd" in
    nf)    cmd_wt_nf "$@" ;;
    nb)    cmd_wt_nb "$@" ;;
    ls)    cmd_wt_ls "$@" ;;
    co)    cmd_wt_co "$@" ;;
    rm)    cmd_wt_rm "$@" ;;
    'rm!')  cmd_wt_rm --force "$@" ;;
    clean)  cmd_wt_clean "$@" ;;
    'clean!') cmd_wt_clean --force "$@" ;;
    help|--help|-h) cmd_wt_help ;;
    *)
      error "Unknown worktree command: $subcmd"
      echo ""
      cmd_wt_help
      exit 1
      ;;
  esac
}

cmd_wt_nf() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    die "Usage: gk wt nf <feature-name>"
  fi

  name="$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"

  if [[ -n "$INITIALS" ]]; then
    name="${INITIALS}-${name}"
  fi

  local branch_name="${FEATURE_PREFIX}${name}"
  validate_branch_name "generated worktree branch" "$branch_name" "gk wt nf"
  local wt_path
  wt_path="$(worktree_dir_name "$name")"
  local base
  base="$(base_branch)"

  preflight_worktree_copy

  info "Fetching latest $base..."
  git fetch origin "$base"

  info "Creating worktree at $wt_path..."
  git worktree add "$wt_path" -b "$branch_name" "origin/$base"
  git -C "$wt_path" branch --unset-upstream 2>/dev/null || true
  copy_worktree_files "$wt_path"

  success "Worktree created at ${BOLD}$wt_path${NC}"
  echo -e "  cd $wt_path"
}

cmd_wt_nb() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    die "Usage: gk wt nb <branch-name>"
  fi

  name="$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"
  validate_branch_name "generated worktree branch" "$name" "gk wt nb"

  local wt_path
  wt_path="$(worktree_dir_name "$name")"
  local base
  base="$(base_branch)"

  preflight_worktree_copy

  info "Fetching latest $base..."
  git fetch origin "$base"

  info "Creating worktree at $wt_path..."
  git worktree add "$wt_path" -b "$name" "origin/$base"
  git -C "$wt_path" branch --unset-upstream 2>/dev/null || true
  copy_worktree_files "$wt_path"

  success "Worktree created at ${BOLD}$wt_path${NC}"
  echo -e "  cd $wt_path"
}

print_worktree_table() {
  local base
  base="$(base_branch)"
  local current_wt
  current_wt="$(git rev-parse --show-toplevel)"

  echo ""
  printf "  ${BOLD}%-4s %-30s %-50s %s${NC}\n" "#" "Branch" "Path" "Status"
  echo "  ─────────────────────────────────────────────────────────────────────────────────"

  local i
  for i in "${!WT_PATHS[@]}"; do
    local wt_path="${WT_PATHS[$i]}"
    local wt_branch="${WT_BRANCHES[$i]}" display_branch
    display_branch="$(truncate_display "$wt_branch" 30)"

    # Current marker
    local marker="  "
    if [[ "$wt_path" == "$current_wt" ]]; then
      marker="${GREEN}● ${NC}"
    fi

    # Dirty marker
    local dirty=""
    if [[ -d "$wt_path" ]]; then
      local status_output
      status_output="$(git -C "$wt_path" status --porcelain 2>/dev/null || echo "")"
      if [[ -n "$status_output" ]]; then
        dirty=" ${YELLOW}*${NC}"
      fi
    fi

    # Ahead/behind relative to base
    local ab=""
    if [[ "$wt_branch" != "(detached)" && "$wt_branch" != "???" ]]; then
      local ahead=0 behind=0
      ahead="$(git -C "$wt_path" rev-list --count "origin/$base..HEAD" 2>/dev/null || echo "0")"
      behind="$(git -C "$wt_path" rev-list --count "HEAD..origin/$base" 2>/dev/null || echo "0")"
      if [[ "$ahead" -gt 0 && "$behind" -gt 0 ]]; then
        ab="${GREEN}${ahead}↑${NC} ${RED}${behind}↓${NC}"
      elif [[ "$ahead" -gt 0 ]]; then
        ab="${GREEN}${ahead}↑${NC}"
      elif [[ "$behind" -gt 0 ]]; then
        ab="${RED}${behind}↓${NC}"
      fi
    fi

    printf "${marker}${BOLD}%-4s${NC} %-30s " "$i" "$display_branch"
    print_worktree_path_cell "$wt_path" "$current_wt" 50
    printf " %s%s\n" "$ab" "$dirty"
  done
  echo ""
}

cmd_wt_ls() {
  parse_worktrees

  if [[ ${#WT_PATHS[@]} -eq 0 ]]; then
    info "No worktrees found."
    return
  fi

  print_worktree_table
}

cmd_wt_co() {
  if [[ $# -gt 1 ]]; then
    die "Usage: gk wt co [index]"
  fi

  local current_wt choice target i
  current_wt="$(git rev-parse --show-toplevel)"

  parse_worktrees

  if [[ $# -eq 1 ]]; then
    choice="$1"
  elif [[ ${#WT_PATHS[@]} -le 1 ]]; then
    info "No other worktrees to switch to." >&2
    return
  else
    # Keep selector UI on stderr so stdout stays clean for shell integration.
    print_worktree_table >&2
    echo -n "Switch to [#]: " >&2
    if ! read -r choice || [[ -z "$choice" ]]; then
      info "Aborted." >&2
      return
    fi
  fi

  # Validate canonical decimal spelling, then compare only with real array
  # indices. This avoids arithmetic evaluation of user-controlled input.
  if [[ ! "$choice" =~ ^(0|[1-9][0-9]*)$ ]]; then
    die "Invalid selection: $choice"
  fi

  target=""
  for i in "${!WT_PATHS[@]}"; do
    if [[ "$choice" == "$i" ]]; then
      target="${WT_PATHS[$i]}"
      break
    fi
  done
  if [[ -z "$target" ]]; then
    die "Invalid selection: $choice"
  fi

  if [[ "$target" == "$current_wt" ]]; then
    info "Already in that worktree." >&2
    return
  fi

  # Print path to stdout for cd
  echo "$target"
}

cmd_wt_rm() {
  local force=false
  if [[ "${1:-}" == "--force" ]]; then
    force=true
    shift
  fi

  local target="${1:-}"
  if [[ -z "$target" ]]; then
    die "Usage: gk wt rm <index|name>"
  fi

  parse_worktrees

  local rm_path="" rm_branch=""

  # Check if target is a number (index)
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    if [[ "$target" -ge "${#WT_PATHS[@]}" ]]; then
      die "Index $target is out of range. Run 'gk wt ls' to see available worktrees."
    fi
    rm_path="${WT_PATHS[$target]}"
    rm_branch="${WT_BRANCHES[$target]}"
  else
    # Match by worktree name (the basename after '--') or branch name. Prefer an
    # exact match; only fall back to substring matching when nothing matches
    # exactly, and refuse to guess when a substring is ambiguous.
    local i wt_name
    for i in "${!WT_BRANCHES[@]}"; do
      wt_name="${WT_PATHS[$i]##*/}"   # basename of the worktree path
      wt_name="${wt_name##*--}"       # name after the '--' separator
      if [[ "$wt_name" == "$target" || "${WT_BRANCHES[$i]}" == "$target" ]]; then
        rm_path="${WT_PATHS[$i]}"
        rm_branch="${WT_BRANCHES[$i]}"
        break
      fi
    done

    if [[ -z "$rm_path" ]]; then
      local -a hits=()
      for i in "${!WT_BRANCHES[@]}"; do
        wt_name="${WT_PATHS[$i]##*/}"
        wt_name="${wt_name##*--}"
        if [[ "$wt_name" == *"$target"* || "${WT_BRANCHES[$i]}" == *"$target"* ]]; then
          hits+=("$i")
        fi
      done
      if [[ ${#hits[@]} -eq 1 ]]; then
        rm_path="${WT_PATHS[${hits[0]}]}"
        rm_branch="${WT_BRANCHES[${hits[0]}]}"
      elif [[ ${#hits[@]} -gt 1 ]]; then
        error "Multiple worktrees match '$target':"
        for i in "${hits[@]}"; do
          echo "  - ${WT_BRANCHES[$i]} (${WT_PATHS[$i]})" >&2
        done
        die "Be more specific - use an index from 'gk wt ls' or an exact name."
      fi
    fi
  fi

  if [[ -z "$rm_path" ]]; then
    die "Worktree not found: $target"
  fi

  # Don't allow removing the main worktree
  local main_path
  main_path="$(main_worktree_path)"
  if [[ "$rm_path" == "$main_path" ]]; then
    die "Cannot remove the main worktree."
  fi

  # Guard against silently discarding uncommitted work. Unless forced (wt rm!),
  # confirm before nuking a worktree with a dirty tree.
  if [[ "$force" != true ]]; then
    local wt_status
    wt_status="$(git -C "$rm_path" status --porcelain 2>/dev/null || echo "")"
    if [[ -n "$wt_status" ]]; then
      warn "Worktree at $rm_path has uncommitted changes that will be lost."
      read -r -p "Remove anyway? [y/N] " confirm
      if [[ "$confirm" != [yY] ]]; then
        info "Aborted."
        return
      fi
    fi
  fi

  info "Removing worktree at $rm_path..."
  remove_worktree_checked "$main_path" "$rm_path"

  # Delete branch if it was merged
  local base
  base="$(base_branch)"
  if [[ "$rm_branch" != "(detached)" && "$rm_branch" != "???" ]]; then
    if branch_merged_into_base "$main_path" "$base" "$rm_branch"; then
      if delete_merged_branch "$main_path" "$rm_branch"; then
        success "Worktree removed. Branch $rm_branch deleted (was merged)."
      else
        error "Worktree removed, but could not delete merged branch $rm_branch."
        return 1
      fi
    else
      success "Worktree removed. Branch $rm_branch kept (not yet merged)."
    fi
  else
    success "Worktree removed."
  fi
}

cmd_wt_clean() {
  local force=false
  if [[ "${1:-}" == "--force" ]]; then
    force=true
    shift
  fi

  local base
  base="$(base_branch)"
  local main_path
  main_path="$(main_worktree_path)"

  parse_worktrees

  # Collect merged worktrees
  local -a clean_paths=()
  local -a clean_branches=()
  for i in "${!WT_PATHS[@]}"; do
    local wt_path="${WT_PATHS[$i]}"
    local wt_branch="${WT_BRANCHES[$i]}"

    # Skip main worktree
    if [[ "$wt_path" == "$main_path" ]]; then
      continue
    fi

    # Skip detached / unknown
    if [[ "$wt_branch" == "(detached)" || "$wt_branch" == "???" ]]; then
      continue
    fi

    # Check if merged
    if branch_merged_into_base "$main_path" "$base" "$wt_branch"; then
      # In the non-force path, don't remove a worktree with uncommitted changes.
      # 'gk wt clean!' (--force) removes merged worktrees regardless.
      if [[ "$force" != true ]]; then
        local wt_status
        wt_status="$(git -C "$wt_path" status --porcelain 2>/dev/null || echo "")"
        if [[ -n "$wt_status" ]]; then
          warn "Skipping $wt_branch - worktree has uncommitted changes (use 'gk wt clean!' to force)."
          continue
        fi
      fi
      clean_paths+=("$wt_path")
      clean_branches+=("$wt_branch")
    fi
  done

  if [[ ${#clean_paths[@]} -eq 0 ]]; then
    info "No merged worktrees to clean up."
    return
  fi

  # List worktrees that will be removed
  warn "The following merged worktrees will be removed:"
  echo ""
  for i in "${!clean_paths[@]}"; do
    echo "  - ${clean_branches[$i]} (${clean_paths[$i]})"
  done
  echo ""

  if [[ "$force" != true ]]; then
    read -r -p "Proceed? [y/N] " confirm
    if [[ "$confirm" != [yY] ]]; then
      info "Aborted."
      return
    fi
  fi

  # Removing a worktree can delete the directory this process is running from
  # (when clean is invoked from inside a merged worktree), after which a bare
  # `git` cannot read its cwd. Every git call in this loop must therefore run
  # against the main worktree - both helpers below pin -C "$main_path" for that
  # reason, so keep any new git invocation here going through them.
  local removed=0
  local failures=0
  for i in "${!clean_paths[@]}"; do
    info "Removing ${clean_branches[$i]} (${clean_paths[$i]})..."
    if remove_worktree_checked "$main_path" "${clean_paths[$i]}"; then
      if delete_merged_branch "$main_path" "${clean_branches[$i]}" 2>/dev/null; then
        success "Removed ${clean_branches[$i]}"
      else
        warn "Removed worktree ${clean_branches[$i]}, but could not delete its branch."
      fi
      removed=$((removed + 1))
    else
      error "Could not remove ${clean_branches[$i]} (${clean_paths[$i]})."
      failures=$((failures + 1))
    fi
  done

  success "Cleaned up $removed worktree(s)."
  [[ "$failures" -eq 0 ]] || return 1
}

cmd_wt_help() {
  cat <<EOF
${BOLD}git-kiss worktree${NC} - manage git worktrees

${BOLD}USAGE${NC}
  gk wt <command> [args]

${BOLD}COMMANDS${NC}
  nf <name>          New worktree with feature branch (uses prefix + initials)
  nb <name>          New worktree with plain branch
  ls                 List all worktrees with status
  co [index]         Checkout a worktree (interactive status table or displayed index)
  rm <index|name>    Remove a worktree by index or branch name (prompts if dirty)
  rm! <index|name>   Remove a worktree, skipping the dirty-tree prompt
  clean              Remove merged worktrees (skips any with uncommitted changes)
  clean!             Remove merged worktrees, including any with uncommitted changes

${BOLD}EXAMPLES${NC}
  gk wt nf login          Create worktree with feature/mj-login branch
  gk wt nb hotfix-db       Create worktree with hotfix-db branch
  gk wt ls                 List worktrees (numbered)
  gk wt co [index]         Checkout a worktree interactively or by displayed index
  gk wt rm 2               Remove worktree #2
  gk wt rm login           Remove worktree matching "login"
  gk wt rm! login          Remove worktree "login" even if it has uncommitted changes
  gk wt clean              Clean up merged worktrees

${BOLD}CONFIG${NC}
  worktree_copy     JSON array of files/folders (literal paths or globs) copied into
                    new worktrees. Useful for gitignored files like .env.
                    Example (.gitkiss.local.jsonc): "worktree_copy": [".env*", "config/local"]
  .worktreeinclude  Optional file in the project root, .gitignore-style (one glob per
                    line, # comments, blank lines ignored). When present it is authoritative
                    and suppresses worktree_copy. Absolute/traversal patterns are refused.
                    Relative symlinks are copied only when their targets are also copied.

${BOLD}TIP${NC}
  Add shell integration so 'gk wt co' cds you straight there:
    eval "\$(gk shell-init)"     # in ~/.bashrc or ~/.zshrc
  (Or keep the manual alias:  alias wtco='cd \$(gk wt co)')

EOF
}

cmd_help() {
  cat <<EOF
${BOLD}git-kiss${NC} v${VERSION} - Keep It Simple, Stupid git flow

${BOLD}USAGE${NC}
  gk <command> [args]

${BOLD}COMMANDS${NC}
  nf <name>    New feature branch
  ff           Finish current feature (merge into base, print push hint)
  ff!          Finish current feature (merge, push, delete branch)
  sf           Squash feature commits into one (with prompt)
  sf!          Squash feature commits into one (no prompt)
  cm <msg>     Add all changes and commit with message
  rc / rc!     Reset last commit safely / force an exceptional reset
  pf           Publish feature branch to remote
  pr <title>    Create a pull request (requires gh CLI)
  pr ls         List pull requests for local branches
  rf           Rebase feature branch against base branch
  ds           Deploy to staging (prompt to force push)
  ds!          Deploy to staging (force push automatically)
  dp           Deploy to production (tag release, prompt to push)
  dp!          Deploy to production (tag release and push)
  wt <cmd>     Worktree management (run 'gk wt help' for details)
  init         Initialize JSONC config in current repo
  migrate      Migrate legacy .gitkiss (shell) to JSONC config
  shell-init   Print shell integration (eval "\$(gk shell-init)")
  version      Print the installed version

${BOLD}CONFIG${NC} (JSONC, cascading - later overrides earlier)
  Global:   ~/.gk/.gitkiss.jsonc
  Project:  ~/.gk/projects.jsonc
  Team:     .gitkiss.jsonc        (commit this)
  Personal: .gitkiss.local.jsonc  (gitignored)

  Run ${BOLD}gk init${NC} to generate config, or ${BOLD}gk migrate${NC} to upgrade an old one.

EOF
}

cmd_version() {
  echo "gk v${VERSION}"
}

cmd_shell_init() {
  cat <<'EOF'
gk() {
  if [ "${1:-}" = "wt" ] && [ "${2:-}" = "co" ]; then
    local _gk_dir
    _gk_dir="$(command gk "$@")" || return $?
    if [ -n "$_gk_dir" ]; then
      cd "$_gk_dir"
    fi
  else
    command gk "$@"
  fi
}
EOF
}

# ─── Dispatcher ──────────────────────────────────────────────────────────────

main() {
  debug "gk v${VERSION} - $(bash --version | head -1)"

  if [[ "${1:-}" == "shell-init" ]]; then
    cmd_shell_init
    exit 0
  fi

  local cmd="${1:-help}"
  shift || true
  debug "command: gk $cmd $*"

  case "$cmd" in
    help|--help|-h) cmd_help; return ;;
    version|--version) cmd_version; return ;;
  esac

  require_git_repo

  # An explicit migration must decide what to migrate before normal command
  # preparation has a chance to perform an automatic migration.
  if [[ "$cmd" == "migrate" ]]; then
    cmd_migrate "$@"
    return
  fi

  prepare_global_state || true
  load_config

  if needs_onboarding "$cmd" "${1:-}"; then
    warn "No git-kiss configuration found for this project."
    cmd_init --automatic
    load_config
  fi

  case "$cmd" in
    nf)       cmd_nf "$@" ;;
    ff)       cmd_ff "$@" ;;
    'ff!')    cmd_ff --force "$@" ;;
    sf)       cmd_fs "$@" ;;
    'sf!')    cmd_fs --force "$@" ;;
    cm)       cmd_cm "$@" ;;
    rc)       cmd_rc "$@" ;;
    'rc!')    cmd_rc --force "$@" ;;
    pf)       cmd_pf "$@" ;;
    pr)       cmd_pr "$@" ;;
    dp)       cmd_dp "$@" ;;
    'dp!')    cmd_dp --force "$@" ;;
    ds)       cmd_ds "$@" ;;
    'ds!')    cmd_ds --force "$@" ;;
    rf)       cmd_rf "$@" ;;
    wt)       cmd_wt "$@" ;;
    init)     cmd_init "$@" ;;
    *)
      error "Unknown command: $cmd"
      echo ""
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"

# Post-command version check (once per day, non-blocking on failure)
check_version || true
