// git-kiss team config - commit this to share with your team.
// Cascading: ~/.git-kiss.jsonc (global) -> .gitkiss.jsonc (team) -> .gitkiss.local.jsonc (personal).
// Docs: https://github.com/mjeffrey18/git-kiss
//
// Comments must be on their own line (// only). Run `gk init` to generate this.
// Set develop_branch / staging_branch to "" for simple flow.
{
  "main_branch": "main",
  "develop_branch": "develop",
  "staging_branch": "staging",
  "feature_prefix": "feature/",
  "use_tags": true
}
